# Backend (see backend/internal/platform/config/config.go)
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://neuratop:neuratop@127.0.0.1:55432/neuratop?sslmode=disable
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ALLOWED_ORIGIN=http://localhost:5173

# SMTP is optional in development: when SMTP_HOST is unset, one-time codes
# (registration/login/password-reset) are logged to stdout instead of
# emailed, so the app is fully testable without a mail server.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@neuratop.com

# Puzzle source is likewise optional: when PUZZLE_API_EMAIL/PASSWORD are
# unset, generation falls back to the local fixture set (fixtures/puzzles.json)
# instead of the external Neuratrap trainer recommendation API.
PUZZLE_API_BASE_URL=https://api-go-dev.neuratrap.com
PUZZLE_API_EMAIL=
PUZZLE_API_PASSWORD=
